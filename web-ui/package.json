{
  "name": "web-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && esbuild src/lib/set-password-cli.ts --bundle --platform=node --format=esm --target=node22 --log-level=warning --outfile=.output/cli/set-password.mjs",
    "preview": "vite preview",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:reset": "python ../scripts/seed_test_data.py",
    "db:reset:empty": "python ../scripts/seed_test_data.py --empty",
    "db:reset:5y": "python ../scripts/seed_test_data.py --years 5",
    "db:studio": "drizzle-kit studio",
    "format": "biome format --write",
    "lint": "biome lint --write --unsafe",
    "typecheck": "tsc --noEmit",
    "classes": "tsx scripts/canonicalize-classes.ts",
    "link-images": "tsx scripts/render-link-images.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "clean": "npm run classes && biome check --write --unsafe && tsc --noEmit",
    "smoke": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260903-beta",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/node": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  }
}
